{
  "name": "tigermatch-couples-survey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "docker compose up -d db && ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/db-init.ts",
    "dev": "next dev",
    "warm": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/dev-warmup.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:status": "docker ps --filter name=tigermatch-postgres --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'",
    "db:setup": "npm run db:up && ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/db-init.ts",
    "export:csv": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/export.ts",
    "export:couples": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/export-couples.ts",
    "couple:create": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/create-couple.ts",
    "alg:run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/run-analysis.ts"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.0",
    "dotenv": "^16.6.1",
    "framer-motion": "^11.0.0",
    "next": "14.1.0",
    "pg": "^8.12.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.49.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
