# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/tigermatch?schema=public"

# Optional server-side timezone for timestamps (defaults to America/New_York)
DB_TIMEZONE="America/New_York"

# Admin key for /api/admin/export
ADMIN_KEY="set-a-strong-random-string"

# NEXT_PUBLIC_SITE_NAME appears in headers
NEXT_PUBLIC_SITE_NAME="TigerMatch Couples Survey"
